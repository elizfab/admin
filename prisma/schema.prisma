// Schema do banco. Documentação: https://pris.ly/d/prisma-schema
// Diagrama ER correspondente: docs/architecture/database-erd.drawio

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identidade ──────────────────────────────────────────────
// Formato compatível com o Better Auth (Fase 03), que adicionará
// as tabelas session, account e verification.

enum UserRole {
  ADMIN
  USER
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(USER)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions     Session[]
  accounts     Account[]
  projects     Project[]
  transactions Transaction[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// ─── Projetos ────────────────────────────────────────────────

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  DONE
}

model Project {
  id            String        @id @default(cuid())
  name          String        @db.VarChar(100)
  description   String?       @db.VarChar(500)
  status        ProjectStatus @default(PLANNED)
  repositoryUrl String?
  ownerId       String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Restrict: não é possível apagar um usuário que ainda tem projetos.
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  // Um mesmo usuário não pode ter dois projetos com o mesmo nome.
  // Este índice composto também acelera as buscas por ownerId.
  @@unique([ownerId, name])
  @@map("project")
}

// ─── Financeiro ──────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  SALARY
  HOUSING
  FOOD
  TRANSPORT
  HEALTH
  EDUCATION
  LEISURE
  OTHER
}

model Transaction {
  id          String              @id @default(cuid())
  type        TransactionType
  description String              @db.VarChar(120)
  // Dinheiro em CENTAVOS (inteiro): R$ 12,34 = 1234. Sem erro de arredondamento.
  amountCents Int
  category    TransactionCategory @default(OTHER)
  // Só a data (sem hora): o dia em que a receita/despesa aconteceu.
  occurredOn  DateTime            @db.Date
  ownerId     String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  // As consultas sempre filtram por dona + período (resumo do mês).
  @@index([ownerId, occurredOn])
  @@map("transaction")
}
