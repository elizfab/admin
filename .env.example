# Copie para .env.local e preencha os valores reais.
# Nunca commite .env.local.

# ─── Banco de dados (Fase 02) ───────────────────────────────
# Runtime da aplicação (no Supabase: pooler em modo transaction).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/admin_dev"
# Migrations e seed (conexão direta).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/admin_dev"

# ─── Autenticação (Fase 03) ─────────────────────────────────
# Gerar com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Seed da conta administradora (somente local; use uma senha forte e única)
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Somente nos PREVIEWS da Vercel (no lugar de BETTER_AUTH_URL):
# BETTER_AUTH_ALLOWED_HOSTS="personal-platform-admin-*-elizfab.vercel.app"
